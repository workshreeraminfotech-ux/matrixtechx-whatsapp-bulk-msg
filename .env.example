# MatrixTechX WhatsApp Bulk Messenger - Environment Variables
# Copy this file to .env and fill in your values

# Server
PORT=3000
NODE_ENV=development

# JWT Secret (change this to a random string in production)
JWT_SECRET=matrixtechx_super_secret_key_2024_change_this

# WhatsApp Business Cloud API (Meta)
WHATSAPP_ACCESS_TOKEN=your_permanent_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id_here
WHATSAPP_WEBHOOK_VERIFY_TOKEN=matrixtechx_webhook_verify_2024
WHATSAPP_API_VERSION=v20.0

# App URL (for webhook)
APP_URL=https://your-domain.com

# Admin credentials (for first login)
ADMIN_EMAIL=admin@matrixtechx.com
ADMIN_PASSWORD=Admin@123456
ADMIN_NAME=MatrixTechX Admin
