{
  "version": 2,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/dashboard", "destination": "/public/dashboard.html" },
    { "source": "/dashboard.html", "destination": "/public/dashboard.html" },
    { "source": "/login", "destination": "/public/index.html" },
    { "source": "/index.html", "destination": "/public/index.html" },
    { "source": "/css/(.*)", "destination": "/public/css/$1" },
    { "source": "/js/(.*)", "destination": "/public/js/$1" },
    { "source": "/", "destination": "/public/index.html" }
  ]
}
